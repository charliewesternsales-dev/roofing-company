# Add a verified public origin to enable indexing and the sitemap.
NEXT_PUBLIC_SITE_URL=https://roofing-company-omega.vercel.app
# Server-only Resend key. Never prefix this variable with NEXT_PUBLIC_.
RESEND_API_KEY=
# Sender on a domain you have verified in Resend, e.g. estimates@yourdomain.com.
RESEND_FROM_EMAIL=
# Inbox that receives estimate requests. Replies go to the homeowner.
ESTIMATE_TO_EMAIL=keetonplatinumext@gmail.com
